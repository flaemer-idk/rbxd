{
  "agent_servers": {},
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "terminal": {
    "cursor_shape": "underline",
    "minimum_contrast": 32.0,
    "default_width": 640.0,
    "font_size": 14.0,
    "font_weight": 100.0,
    "ui_font_family": "Cantarell",
    "buffer_font_family": "Fira Code"
  },
  "agent": {
    "sandbox_permissions": {
      "allow_unsandboxed": true,
      "network_hosts": [
        "mesonbuild.com",
        "man.archlinux.org",
        "api.github.com",
        "gitlab.gnome.org"
      ]
    },
    "tool_permissions": {
      "default": "allow",
      "tools": {
        "terminal": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "^grep\\b"
            },
            {
              "pattern": "^head\\b"
            },
            {
              "pattern": "^sed\\b"
            }
          ]
        }
      }
    },
    "dock": "right",
    "message_editor_min_lines": 5,
    "default_profile": "minimal",
    "default_model": {
      "effort": "medium",
      "provider": "kios",
      "model": "deepseek-v4-flash",
      "enable_thinking": true
    },
    "favorite_models": [
      {
        "provider": "aitunnel",
        "model": "glm-5.3-flash",
        "enable_thinking": true,
        "effort": "minimal"
      }
    ],
    "model_parameters": []
  },
  "session": {
    "trust_all_worktrees": true
  },
  "icon_theme": {
    "mode": "light",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme"
  },
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Material Dark"
  },
  "auto_install_extensions": {
    "csv": true,
    "env": true,
    "git-firefly": true,
    "make": true,
    "material-dark": true,
    "material-icon-theme": true,
    "python-requirements": true,
    "toml": true,
    "vala": true,
    "xml": true
  },
